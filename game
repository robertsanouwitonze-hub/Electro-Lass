<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Highway Racer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a2e;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
        }
        .game-wrapper {
            background: #16213e;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            text-align: center;
        }
        canvas {
            background: #2d3436;
            display: block;
            border-radius: 12px;
            border: 4px solid #0f3460;
            width: 400px;
            height: 600px;
        }
        .info {
            margin-top: 15px;
            color: #eee;
            font-size: 18px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            padding: 0 10px;
        }
        .info span {
            background: #0f3460;
            padding: 8px 20px;
            border-radius: 30px;
        }
        .controls {
            color: #aaa;
            font-size: 14px;
            margin-top: 10px;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
<div class="game-wrapper">
    <canvas id="gameCanvas" width="400" height="600"></canvas>
    <div class="info">
        <span>🏁 Score: <span id="scoreDisplay">0</span></span>
        <span>⚡ Speed: <span id="speedDisplay">1</span></span>
    </div>
    <div class="controls">⬅️ ➡️ Arrow Keys to Steer | Space to Restart</div>
</div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreSpan = document.getElementById('scoreDisplay');
    const speedSpan = document.getElementById('speedDisplay');

    // Game variables
    let score = 0;
    let gameOver = false;
    let frame = 0;
    let speed = 3;

    // Road variables (for moving dashed line)
    let roadOffset = 0;

    // Player
    const player = {
        x: 200 - 25, // center of canvas minus half width
        y: 500,
        width: 40,
        height: 70,
        color: '#00d2ff',
        draw() {
            ctx.shadowColor = '#00d2ff';
            ctx.shadowBlur = 20;
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.roundRect(this.x, this.y, this.width, this.height, 8);
            ctx.fill();
            // Windshield
            ctx.shadowBlur = 0;
            ctx.fillStyle = '#a8d8ea';
            ctx.beginPath();
            ctx.roundRect(this.x + 5, this.y + 10, 30, 15, 4);
            ctx.fill();
            // Headlights
            ctx.fillStyle = '#ffeaa7';
            ctx.fillRect(this.x + 4, this.y + this.height - 8, 8, 5);
            ctx.fillRect(this.x + this.width - 12, this.y + this.height - 8, 8, 5);
        }
    };

    // Enemies array
    let enemies = [];

    // Utility: roundRect
    CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r) {
        if (w < 2 * r) r = w / 2;
        if (h < 2 * r) r = h / 2;
        this.moveTo(x + r, y);
        this.lineTo(x + w - r, y);
        this.quadraticCurveTo(x + w, y, x + w, y + r);
        this.lineTo(x + w, y + h - r);
        this.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        this.lineTo(x + r, y + h);
        this.quadraticCurveTo(x, y + h, x, y + h - r);
        this.lineTo(x, y + r);
        this.quadraticCurveTo(x, y, x + r, y);
        this.closePath();
        return this;
    };

    // Enemy car
    class Enemy {
        constructor() {
            this.width = 40;
            this.height = 70;
            this.x = Math.random() * (canvas.width - this.width);
            this.y = -this.height;
            this.color = `hsl(${Math.floor(Math.random() * 20 + 340)}, 80%, 55%)`; // reds/oranges
            this.speed = speed + (Math.random() * 1.5 - 0.5);
        }

        draw() {
            ctx.shadowColor = this.color;
            ctx.shadowBlur = 15;
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.roundRect(this.x, this.y, this.width, this.height, 8);
            ctx.fill();
            // Windshield
            ctx.shadowBlur = 0;
            ctx.fillStyle = '#2d3436';
            ctx.beginPath();
            ctx.roundRect(this.x + 5, this.y + 10, 30, 15, 4);
            ctx.fill();
            // Taillights
            ctx.fillStyle = '#ff6b6b';
            ctx.fillRect(this.x + 4, this.y + 2, 8, 5);
            ctx.fillRect(this.x + this.width - 12, this.y + 2, 8, 5);
        }

        update() {
            this.y += this.speed;
        }

        isOffScreen() {
            return this.y > canvas.height + 50;
        }
    }

    // Collision detection
    function checkCollision(rect1, rect2) {
        return rect1.x < rect2.x + rect2.width &&
            rect1.x + rect1.width > rect2.x &&
            rect1.y < rect2.y + rect2.height &&
            rect1.y + rect1.height > rect2.y;
    }

    // Reset game
    function resetGame() {
        gameOver = false;
        score = 0;
        speed = 3;
        enemies = [];
        player.x = 200 - 25;
        player.y = 500;
        frame = 0;
        roadOffset = 0;
        updateUI();
    }

    // Update score & speed display
    function updateUI() {
        scoreSpan.textContent = Math.floor(score);
        speedSpan.textContent = Math.floor(speed);
    }

    // Handle keys
    const keys = {
        left: false,
        right: false
    };

    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
            keys.left = true;
            e.preventDefault();
        } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
            keys.right = true;
            e.preventDefault();
        } else if (e.key === ' ' && gameOver) {
            resetGame();
            e.preventDefault();
        }
    });

    document.addEventListener('keyup', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
            keys.left = false;
            e.preventDefault();
        } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
            keys.right = false;
            e.preventDefault();
        }
    });

    // Main game loop
    function gameLoop() {
        if (!gameOver) {
            // 1. Move player
            const moveAmount = 5;
            if (keys.left && player.x > 0) player.x -= moveAmount;
            if (keys.right && player.x < canvas.width - player.width) player.x += moveAmount;

            // 2. Spawn enemies
            frame++;
            const spawnRate = Math.max(20, 60 - Math.floor(speed * 2));
            if (frame % spawnRate === 0) {
                enemies.push(new Enemy());
            }

            // 3. Update enemies & check for score / collision
            for (let i = enemies.length - 1; i >= 0; i--) {
                const enemy = enemies[i];
                enemy.update();

                // Collision
                if (checkCollision(player, enemy)) {
                    gameOver = true;
                }

                // If enemy passes player, increase score
                if (enemy.y > player.y + player.height && !enemy.passed) {
                    enemy.passed = true;
                    score += 10;
                    // Increase speed every 100 points
                    speed = 3 + Math.floor(score / 100) * 0.8;
                    updateUI();
                }

                // Remove if off screen
                if (enemy.isOffScreen()) {
                    enemies.splice(i, 1);
                }
            }

            // 4. Move road
            roadOffset = (roadOffset + speed) % 40;
        }

        // ---- DRAW everything ----
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Draw road (asphalt)
        ctx.fillStyle = '#2c3e50';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Road edges
        ctx.fillStyle = '#b2bec3';
        ctx.fillRect(0, 0, 10, canvas.height);
        ctx.fillRect(canvas.width - 10, 0, 10, canvas.height);

        // Road dashed lines
        ctx.fillStyle = '#dfe6e9';
        for (let y = -40 + roadOffset; y < canvas.height + 40; y += 40) {
            ctx.fillRect(canvas.width / 2 - 5, y, 10, 20);
        }

        // Draw enemies
        for (let enemy of enemies) {
            enemy.draw();
        }

        // Draw player
        player.draw();

        // Draw Game Over overlay
        if (gameOver) {
            ctx.shadowBlur = 0;
            ctx.fillStyle = 'rgba(0,0,0,0.7)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#ff4757';
            ctx.font = 'bold 48px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('💥 CRASH', canvas.width / 2, canvas.height / 2 - 30);
            ctx.fillStyle = '#fff';
            ctx.font = '24px Arial';
            ctx.fillText(`Score: ${Math.floor(score)}`, canvas.width / 2, canvas.height / 2 + 40);
            ctx.font = '18px Arial';
            ctx.fillStyle = '#dfe6e9';
            ctx.fillText('Press SPACE to restart', canvas.width / 2, canvas.height / 2 + 90);
        }

        requestAnimationFrame(gameLoop);
    }

    // Start the game
    resetGame();
    gameLoop();
</script>
</body>
</html>
